<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:background="@color/heatover_backcolor"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <FrameLayout
        android:layout_gravity="center"
        android:background="@drawable/heatover_bg"
        android:layout_width="307.0dip"
        android:layout_height="196.0dip">

        <ImageView
            android:layout_gravity="center"
            android:id="@+id/heatover"
            android:background="@drawable/heatover"
            android:layout_width="98.0dip"
            android:layout_height="86.0dip"
            android:layout_marginBottom="15.0dip"
            android:scaleType="fitXY" />

        <TextView
            android:textSize="18.0dip"
            android:textColor="#fffd001a"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="50.0dip"
            android:text="@string/heatover"
            android:layout_below="@id/heatover" />
    </FrameLayout>
</FrameLayout>